{
  "name": "@harurow/j-quants-doc-mcp",
  "version": "1.0.0",
  "description": "J-Quants API documentation MCP server",
  "license": "MIT",
  "author": "harurow",
  "repository": {
    "type": "git",
    "url": "https://github.com/harurow/j-quants-doc-mcp.git"
  },
  "keywords": [
    "mcp",
    "j-quants",
    "jpx",
    "api",
    "documentation"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "j-quants-doc-mcp": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && cp -r src/data dist/",
